{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.xianmi.co/buddhism/data/schema-chronology-v0.1.json",
  "title": "Buddhist Atlas Chronology Reference v0.1",
  "description": "纪年参考数据集（基础设施，非领域 Profile）：中国年号表（era_names）、佛历换算规则（be_rules）、藏历绕迥/火空海规则（rab_byung_rules）。由 tools/chronology/import_acquisition.py 从 acquisition/chronology/ 机械生成，不得手改。年号-公元对照为事实数据；维基快照来源仅作私有溯源引用（CC BY-SA），不在公开层再发布。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_status", "generated_by", "generated_from", "era_names", "be_rules", "rab_byung_rules"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "dataset_status": {"enum": ["chronology_draft"]},
    "generated_by": {"type": "string", "minLength": 1},
    "generated_from": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "era_names": {"type": "array", "items": {"$ref": "#/$defs/eraName"}},
    "be_rules": {"type": "array", "items": {"$ref": "#/$defs/beRule"}},
    "rab_byung_rules": {"type": "array", "items": {"$ref": "#/$defs/rabByungRule"}}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "datePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month", "precision", "raw"],
      "properties": {
        "year": {"type": ["integer", "null"], "description": "BCE 为历史负年（无公元 0 年：-140=前140年）"},
        "month": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
        "precision": {"enum": ["year", "month", "estimated_range", "unknown"]},
        "raw": {"$ref": "#/$defs/nullableString"},
        "intercalary": {"type": "boolean"},
        "open_ended_suffix": {"type": "boolean"},
        "month_calendar": {"enum": ["lunar", "gregorian", null]},
        "note": {"$ref": "#/$defs/nullableString"}
      }
    },
    "eraName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "era_zh", "alt_names", "dynasty", "regime", "regime_type", "emperor", "start", "end",
                   "duration_years_claimed", "ganzhi_first_year", "ganzhi_basis", "note",
                   "evidence_kind", "source", "accessed", "original_date_text"],
      "properties": {
        "kind": {"const": "era_name"},
        "era_zh": {"type": "string", "minLength": 1},
        "alt_names": {"type": "array", "items": {"type": "string"}},
        "dynasty": {"type": "string", "minLength": 1},
        "regime": {"type": "string", "minLength": 1},
        "regime_type": {"enum": ["chinese_regime", "neighboring_regime"]},
        "emperor": {"$ref": "#/$defs/nullableString"},
        "start": {"$ref": "#/$defs/datePoint"},
        "end": {"$ref": "#/$defs/datePoint"},
        "duration_years_claimed": {"$ref": "#/$defs/nullableString"},
        "ganzhi_first_year": {"type": ["string", "null"], "pattern": "^[甲乙丙丁戊己庚辛壬癸][子丑寅卯辰巳午未申酉戌亥]$"},
        "ganzhi_basis": {"enum": ["computed_sexagenary", null]},
        "note": {"$ref": "#/$defs/nullableString"},
        "evidence_kind": {"enum": ["modern_scholarship", "physical_evidence"]},
        "source": {"type": "string", "minLength": 1},
        "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "original_date_text": {"type": "string"},
        "id": {"type": "string", "pattern": "^ERA-UNNAMED-.+-\\d+$",
               "description": "无名年号占位（共戴政权用），仅 12 条；有年号者不填"},
        "needs_review": {"type": "string"},
        "review_ruling": {"type": "string"},
        "ranges": {"type": "array", "minItems": 2,
                   "items": {"type": "object", "additionalProperties": false,
                             "required": ["start", "end"],
                             "properties": {"start": {"$ref": "#/$defs/datePoint"}, "end": {"$ref": "#/$defs/datePoint"}}},
                   "description": "共戴/中断复用政权的分段实态（如共戴 1911–1915、1921–1924）"}
      }
    },
    "beRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "variant", "formula", "boundary", "anchor", "example", "regions", "evidence_kind", "note", "source", "accessed"],
      "properties": {
        "kind": {"const": "be_rule"},
        "variant": {"type": "string", "minLength": 1},
        "formula": {"$ref": "#/$defs/nullableString"},
        "boundary": {"$ref": "#/$defs/nullableString"},
        "anchor": {"$ref": "#/$defs/nullableString"},
        "example": {"$ref": "#/$defs/nullableString"},
        "regions": {"type": "array", "items": {"type": "string"}},
        "evidence_kind": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    },
    "rabByungRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "epoch_ce", "cycle_years", "formula", "first_year", "correspondence", "example", "regions", "evidence_kind", "note", "source", "accessed"],
      "properties": {
        "kind": {"const": "rab_byung_rule"},
        "name": {"type": "string", "minLength": 1},
        "epoch_ce": {"type": "integer"},
        "cycle_years": {"type": ["integer", "null"], "minimum": 1},
        "formula": {"type": "string", "minLength": 1},
        "first_year": {"type": "string", "minLength": 1},
        "correspondence": {"type": ["string", "null"]},
        "example": {"type": "string", "minLength": 1},
        "regions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_kind": {"type": "string", "minLength": 1},
        "note": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  }
}
