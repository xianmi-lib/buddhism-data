{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.xianmi.co/buddhism/data/schema-atlas-v0.1.json",
  "title": "Buddhist Text & Transmission Atlas sample package v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_status",
    "works",
    "text_versions",
    "witnesses",
    "events",
    "assertions",
    "relations",
    "sample_cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "dataset_status": {
      "enum": [
        "research_sample",
        "backbone_draft"
      ]
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work",
        "unevaluatedProperties": false
      }
    },
    "text_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/textVersion",
        "unevaluatedProperties": false
      }
    },
    "witnesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/witness",
        "unevaluatedProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event",
        "unevaluatedProperties": false
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion",
        "unevaluatedProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation",
        "unevaluatedProperties": false
      }
    },
    "sample_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sampleCase",
        "unevaluatedProperties": false
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalogued": {
      "type": "object",
      "required": [
        "id",
        "catalog_key",
        "content_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "catalog_key": {
          "type": "string",
          "minLength": 1
        },
        "content_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "work": {
      "allOf": [
        {
          "$ref": "#/$defs/catalogued"
        },
        {
          "type": "object",
          "required": [
            "name_zh",
            "work_kind"
          ],
          "properties": {
            "name_zh": {
              "type": "string",
              "minLength": 1
            },
            "work_kind": {
              "type": "string"
            },
            "parent_work_id": {
              "$ref": "#/$defs/nullableString"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ]
    },
    "textVersion": {
      "allOf": [
        {
          "$ref": "#/$defs/catalogued"
        },
        {
          "type": "object",
          "required": [
            "work_id",
            "language",
            "canonical_ids"
          ],
          "properties": {
            "work_id": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "script": {
              "type": "string"
            },
            "canonical_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "attribution_display": {
              "$ref": "#/$defs/nullableString"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ]
    },
    "witness": {
      "allOf": [
        {
          "$ref": "#/$defs/catalogued"
        },
        {
          "type": "object",
          "required": [
            "name",
            "witness_kind",
            "text_version_ids",
            "repository_parts"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "witness_kind": {
              "type": "string"
            },
            "text_version_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "material": {
              "type": "string"
            },
            "repository_parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "repository",
                  "shelfmark"
                ],
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "shelfmark": {
                    "$ref": "#/$defs/nullableString"
                  }
                }
              }
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "registry_id",
        "citation",
        "url",
        "locator",
        "accessed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^SRC-"
        },
        "citation": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "locator": {
          "type": "string"
        },
        "accessed": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "date": {
      "$ref": "https://www.xianmi.co/buddhism/data/schema-core-v0.1.json#/$defs/date"
    },
    "eventPlace": {
      "type": "object",
      "required": [
        "place_id",
        "place_text",
        "role",
        "certainty",
        "assertion_ids"
      ],
      "properties": {
        "place_id": {
          "$ref": "#/$defs/nullableString"
        },
        "place_text": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "certainty": {
          "enum": [
            "source_attested",
            "probable",
            "uncertain",
            "unknown"
          ]
        },
        "assertion_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "participant": {
      "type": "object",
      "required": [
        "person_id",
        "role",
        "assertion_ids"
      ],
      "properties": {
        "person_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "assertion_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "event": {
      "allOf": [
        {
          "$ref": "https://www.xianmi.co/buddhism/data/schema-core-v0.1.json#/$defs/eventBase"
        },
        {
          "type": "object",
          "required": [
            "case_id",
            "subject_refs",
            "related_event_ids",
            "notes"
          ],
          "properties": {
            "case_id": {
              "type": "string"
            },
            "subject_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "related_event_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "event_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "religious_teaching",
                  "religious_transmission",
                  "religious_suppression",
                  "textual_transcription",
                  "commentarial_compilation",
                  "manuscript_copying",
                  "woodblock_printing",
                  "text_translation",
                  "person_movement",
                  "text_transfer",
                  "canon_block_carving_project",
                  "manuscript_discovery",
                  "modern_edition_project"
                ]
              }
            },
            "places": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/eventPlace"
              }
            },
            "participants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/participant"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ]
    },
    "assertion": {
      "$ref": "https://www.xianmi.co/buddhism/data/schema-core-v0.1.json#/$defs/assertion"
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "type",
        "from_id",
        "to_id",
        "assertion_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "from_id": {
          "type": "string"
        },
        "to_id": {
          "type": "string"
        },
        "assertion_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sampleCase": {
      "type": "object",
      "required": [
        "id",
        "title",
        "challenge",
        "event_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "challenge": {
          "type": "string"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
